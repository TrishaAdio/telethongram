# /etc/telethongram/env  — chown root:telethongram, chmod 0640
# Nothing in this file is ever logged or returned by any endpoint.
#
# Comments must be on their own line. systemd's EnvironmentFile does not strip a
# trailing "# ..." from a value, and neither does `env $(cat ...)`.

# --- required ---------------------------------------------------------------
# python -m backend.cli keygen
SECRET_KEY=replace-me-with-48-random-bytes
# python -m backend.cli hash
WEB_PASSWORD_HASH=replace-me-with-an-argon2id-hash

# --- telegram (my.telegram.org) ---------------------------------------------
TG_API_ID=0
TG_API_HASH=
# telethon = your real account. fake = in-memory, no Telegram at all.
GATEWAY=telethon

# --- process ---------------------------------------------------------------
HOST=127.0.0.1
PORT=4000
DATA_DIR=/var/lib/telethongram
FRONTEND_DIR=/opt/telethongram/frontend
ALLOWED_ORIGINS=https://telethongram.example.com
COOKIE_SECURE=true
LOG_LEVEL=INFO

# --- behaviour -------------------------------------------------------------
COMMAND_PREFIX=.
# true also deletes the .addweb message from Telegram itself
DELETE_COMMAND_MESSAGES=false
# true makes pin/mute/archive change real Telegram dialog state
MIRROR_DIALOG_STATE=true
# true syncs drafts to your phone
TELEGRAM_DRAFTS=false
# true makes "Clear history" delete for real, with no confirmation in the UI
DESTRUCTIVE_CLEAR_HISTORY=false
# Saved Messages is the Forward target the UI hard-codes; keep this on
AUTO_ENABLE_SAVED=true

# --- media -----------------------------------------------------------------
MEDIA_URL_TTL=900
MEDIA_CACHE_MAX_BYTES=5368709120
MEDIA_MAX_DOWNLOAD_BYTES=104857600
UPLOAD_MAX_BYTES=104857600
