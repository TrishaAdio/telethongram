# /etc/telethongram/env  — chown root:telethongram, chmod 0640
# Nothing in this file is ever logged or returned by any endpoint.

# --- required ---------------------------------------------------------------
# python -m backend.cli keygen
SECRET_KEY=replace-me-with-48-random-bytes
# python -m backend.cli hash
WEB_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=2$...

# --- telegram (my.telegram.org) ---------------------------------------------
TG_API_ID=0
TG_API_HASH=
GATEWAY=telethon            # fake = no Telegram at all, for local checks

# --- process ---------------------------------------------------------------
HOST=127.0.0.1
PORT=4000
DATA_DIR=/var/lib/telethongram
FRONTEND_DIR=/opt/telethongram/frontend
ALLOWED_ORIGINS=https://telethongram.example.com
COOKIE_SECURE=true
LOG_LEVEL=INFO

# --- behaviour (defaults shown) --------------------------------------------
COMMAND_PREFIX=.
DELETE_COMMAND_MESSAGES=false   # true also deletes .addweb from Telegram
MIRROR_DIALOG_STATE=true        # pin/mute/archive change real Telegram state
TELEGRAM_DRAFTS=false           # true syncs drafts to your phone
DESTRUCTIVE_CLEAR_HISTORY=false # true makes "Clear history" delete for real
AUTO_ENABLE_SAVED=true          # Saved Messages is the Forward target

# --- media -----------------------------------------------------------------
MEDIA_URL_TTL=900
MEDIA_CACHE_MAX_BYTES=5368709120
MEDIA_MAX_DOWNLOAD_BYTES=104857600
UPLOAD_MAX_BYTES=104857600
